[Unit]
Description=Install validated private app certificate renewals
[Service]
Type=oneshot
User=root
Group=cluster-certsync
ExecStart=/usr/bin/python3 /usr/local/lib/four-project-cluster/certificate_sync.py apply
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/nginx/tls/four-project /etc/four-project-cluster /var/log/nginx /run/nginx.pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TimeoutStartSec=30
